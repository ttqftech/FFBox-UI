{
  "name": "ffbox-ui",
  "version": "0.7.0",
  "description": "FFBox UI component library based on Lit Web Components",
  "type": "module",
  "main": "./dist/esm/ffbox-ui.js",
  "module": "./dist/esm/ffbox-ui.js",
  "types": "./dist/esm/ffbox-ui.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/ffbox-ui.js",
      "types": "./dist/esm/ffbox-ui.d.ts"
    },
    "./dist/esm/components/*": "./dist/esm/components/*",
    "./dist/esm/utils/*": "./dist/esm/utils/*",
    "./dist/esm/contexts/*": "./dist/esm/contexts/*",
    "./dist/iife/*": "./dist/iife/*",
    "./dist/themes/*": "./dist/themes/*"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "vite --config vite.config.dev.ts",
    "build": "node scripts/build.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lit/context": "^1.1.6",
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "typescript": "^6.0.0",
    "vite": "^6.0.0"
  },
  "author": {
    "name": "滔滔清风"
  },
  "license": "Partially inherited from FFBox, and the right of interpretation belongs to the original author. The current version must not be used for projects not specified by the author."
}
